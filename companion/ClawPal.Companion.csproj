<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ClawPal.Companion</AssemblyName>
    <RootNamespace>ClawPal.Companion</RootNamespace>
    <Version>0.11.0</Version>
    <Authors>MinimalPulse</Authors>
    <Company>MinimalPulse</Company>
    <Copyright>Copyright © 2026 MinimalPulse and contributors</Copyright>
    <RepositoryUrl>https://github.com/Kaayoos/clawpal</RepositoryUrl>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/BuddyOS.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup><Compile Remove="tests/**/*.cs" /></ItemGroup>
  
  <ItemGroup><EmbeddedResource Include="Assets/BuddyOS.ico" LogicalName="ClawPal.Companion.CrabIcon" /></ItemGroup>
<ItemGroup><EmbeddedResource Include="../assets/mascot/*.png" /><EmbeddedResource Include="../assets/logos/*.png" /><EmbeddedResource Include="Payload.zip" Condition="Exists('Payload.zip')" LogicalName="ClawPal.Payload" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="../languages/*.json" LogicalName="ClawPal.Languages.%(Filename).json" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="../boards/catalog.json" LogicalName="ClawPal.Boards" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="../themes/themes.json" LogicalName="ClawPal.Themes" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Assets/timezones.json" LogicalName="ClawPal.TimeZones" /></ItemGroup>
</Project>


